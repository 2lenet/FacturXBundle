{
    "name": "2lenet/facturx-bundle",
    "type": "symfony-bundle",
    "description": "French electronic invoicing: Factur-X EN 16931 XML, seller settings in the config screen, sending to an approved platform (Iopole...)",
    "keywords": [
        "facturx",
        "factur-x",
        "e-invoicing",
        "en16931",
        "iopole"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "doctrine/orm": "^2.6 || ^3.0",
        "doctrine/persistence": "^3.0 || ^4.0",
        "psr/log": "^2.0 || ^3.0",
        "symfony/console": "^7.0 || ^8.0",
        "symfony/framework-bundle": "^7.0 || ^8.0",
        "symfony/http-client": "^7.0 || ^8.0",
        "symfony/mime": "^7.0 || ^8.0",
        "symfony/twig-bundle": "^7.0 || ^8.0"
    },
    "suggest": {
        "2lenet/config-bundle": "Seller, billing framework and notes in the config screen (lle_facturx.config_screen)",
        "2lenet/pdf-generator-bundle": "PDF/A-3 with the Factur-X XML attached (FacturXPdfConverter)",
        "symfony/translation": "Labels of the statuses (@LleFacturX/field/status.html.twig)"
    },
    "autoload": {
        "psr-4": {
            "Lle\\FacturXBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lle\\FacturXBundle\\Tests\\": "tests/phpunit/"
        }
    },
    "minimum-stability": "stable",
    "require-dev": {
        "2lenet/config-bundle": "^1.5",
        "2lenet/pdf-generator-bundle": "^5.0",
        "ergebnis/phpstan-rules": "^2.1",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^10.3",
        "slevomat/coding-standard": "^8.13",
        "squizlabs/php_codesniffer": "^3.7",
        "symfony/translation": "^7.0 || ^8.0",
        "symfony/twig-bridge": "^7.0 || ^8.0",
        "symfony/yaml": "^7.0 || ^8.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
